{
  "manifest_version": 3,
  "name": "GOV-AIOS Teach",
  "version": "0.2.0",
  "key": "",
  "permissions": ["sidePanel", "storage", "scripting", "tabs"],
  "host_permissions": ["http://127.0.0.1:8765/*", "http://localhost/*", "http://127.0.0.1/*"],
  "optional_host_permissions": ["https://*/*"],
  "side_panel": { "default_path": "sidepanel.html" },
  "action": { "default_title": "GOV-AIOS Teach" },
  "background": { "service_worker": "background.js" }
}
